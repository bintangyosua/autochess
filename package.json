{
  "name": "chess-move-reader",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "bridge": "pnpm --filter @cmr/bridge dev",
    "bridge:probe": "pnpm --filter @cmr/bridge probe",
    "dev": "pnpm --filter @cmr/extension dev",
    "build": "pnpm --filter @cmr/extension build",
    "typecheck": "pnpm -r typecheck",
    "build:firefox": "pnpm --filter @cmr/extension exec wxt build -b firefox",
    "android": "powershell -ExecutionPolicy Bypass -File scripts/android.ps1",
    "android:pair": "powershell -ExecutionPolicy Bypass -File scripts/android.ps1 -Pair"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@11.24.0"
}
